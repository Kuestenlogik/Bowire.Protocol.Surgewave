<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bowire contract package (IBowireProtocol + IBowireMockEmitter
         under Kuestenlogik.Bowire.Mocking since Bowire v0.2). -->
    <PackageVersion Include="Kuestenlogik.Bowire" Version="2.3.0" />

    <!-- Surgewave client — the native Surgewave SDK. Resolves from
         ../Surgewave/artifacts/packages during local dev (run
         `dotnet pack` in the Surgewave repo once); from nuget.org for
         release builds. -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Client" Version="0.3.1" />

    <!-- Apache Avro — decodes Confluent wire-format payloads (5-byte magic +
         schema id + Avro body) in the browser. The schema itself is fetched
         over the Confluent-compatible REST API with a plain HttpClient
         (SurgewaveSchemaRegistry), so the plugin carries NO Confluent
         dependency: browsing typed payloads works against a native Surgewave
         registry AND a drop-in Confluent registry, and a fully-migrated
         deployment ships zero Confluent baggage. -->
    <PackageVersion Include="Apache.Avro" Version="1.12.1" />

    <!-- Test-only -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- XPlat coverage collector — drives the dotnet test coverage
         collection flag and drops one cobertura.xml per test project
         for CI / Codecov upload. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>
</Project>
