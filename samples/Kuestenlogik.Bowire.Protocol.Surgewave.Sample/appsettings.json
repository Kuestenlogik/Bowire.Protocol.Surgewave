{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Surgewave": {
    "Storage": "Memory",
    "AutoCreateTopics": true
  },
  "Bowire": {
    "Discovery": {
      "Catalogue": {
        "Provider": "local",
        "Local": {
          "Path": "surgewave-catalogue.json"
        }
      }
    }
  }
}
