<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kuestenlogik.Bowire.Protocol.Surgewave.Sample</RootNamespace>
    <!-- Sample-app code, not a library: CA1515 (make types internal) and
         CA1812 (uninstantiated internal class — the host activates the
         hosted service via DI) don't apply; CA1873 (defer logger-arg
         evaluation) is overkill at this sample's volume. -->
    <NoWarn>$(NoWarn);CA1515;CA1812;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded Bowire (workbench + plugin host) from the published
         package — NO Version, Central Package Management pins it. The
         Surgewave plugin under test is referenced by source and
         force-loaded in Program.cs so AddBowire()'s scan finds it. -->
    <PackageReference Include="Kuestenlogik.Bowire" />
    <ProjectReference Include="..\..\src\Kuestenlogik.Bowire.Protocol.Surgewave\Kuestenlogik.Bowire.Protocol.Surgewave.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process Surgewave broker + a typed producer wired to it
         (builder.AddSurgewave() + AddSurgewaveProducerForEmbeddedBroker) —
         no docker, no external process. Version from central PM; pulls the
         Broker + Client packages transitively. -->
    <PackageReference Include="Kuestenlogik.Surgewave.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="surgewave-catalogue.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
