<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Kuestenlogik.Bowire.* resolves from nuget.org; Kuestenlogik.Surgewave.* still comes
       from the local Surgewave sibling (Surgewave has its own packaging
       layout under ../Surgewave/artifacts/pkg and is published
       separately). Everything else from nuget.org.

       For local restore, run `dotnet pack` in ../Surgewave/ once. -->
  <packageSources>
    <clear />
    <add key="surgewave-local" value="..\Surgewave\artifacts\pkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Pin Kuestenlogik.Surgewave.* to the local feed so a same-named
       package on nuget.org can't shadow the real one. -->
  <packageSourceMapping>
    <packageSource key="surgewave-local">
      <package pattern="Kuestenlogik.Surgewave*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
