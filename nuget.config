<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Both Kuestenlogik.Bowire.* and Kuestenlogik.Surgewave.* now resolve
       from nuget.org. The Surgewave SDK (Kuestenlogik.Surgewave.Client)
       went public on 2026-05-26; before that, the SDK lived in a local
       sibling feed and PackageSourceMapping pinned the namespace there.
       That mapping prevented the release pipeline from restoring the
       now-published SDK, so it was dropped.

       Local development against unreleased Surgewave builds is still
       possible: drop a .nupkg into the global packages folder or pass
       a `dash dash source` argument on `dotnet restore`. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
